@page "/entity/{EntityId}"
@using Agitprop.Web.Client.Components.Shared
@using Agitprop.Web.Client.Models
@inject Agitprop.Web.Client.Services.AnalyticsService Analytics

<PageTitle>Entity Detail</PageTitle>

<div class="page-block">
    <div class="page-section-header">
        <div>
            <h2>Entity details</h2>
            <p>Review the selected entity's trend, related entities, and articles.</p>
        </div>
    </div>

    <section class="detail-summary-panel">
        <div class="summary-card">
            <h3>@Detail?.Name</h3>
            <p class="summary-type">Type: @Detail?.Type</p>
            <p class="summary-value">@Detail?.TotalMentions</p>
            <p class="summary-note">Strongest presence in corporate and economic coverage.</p>
        </div>

        <div class="summary-card">
            <h4>Trend</h4>
            <div class="chart-placeholder small">
                @if (Detail?.Trend?.Any() == true)
                {
                    <ApexChart TItem="TimelinePoint" XAxisType="XAxisType.Datetime">
                        <ApexPointSeries TItem="TimelinePoint"
                                         Items="Detail.Trend"
                                         Name="@Detail.Name"
                                         SeriesType="SeriesType.Line"
                                         Stroke="@(new SeriesStroke { Color = "#0f766e", Width = 2 })"
                                         XValue="point => point.Date.ToDateTime(TimeOnly.MinValue)"
                                         YValue="point => (decimal?)point.Count" />
                    </ApexChart>
                }
                else
                {
                    <span>Loading trend...</span>
                }
            </div>
        </div>
    </section>

    <section class="detail-grid">
        <div class="panel-card">
            <div class="panel-header">
                <h3>Related entities</h3>
            </div>
            <div class="card-list">
                @if (RelatedEntities?.Any() == true)
                {
                    @foreach (var related in RelatedEntities)
                    {
                        <a href="/entity/@related.Id">
                            <EntityChip Label="@related.Name" Type="@related.Type" />
                        </a>
                    }
                }
                else
                {
                    <span>Loading related entities...</span>
                }
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <h3>Mentioning articles</h3>
            </div>
            <ul class="article-list">
                @if (MentioningArticles?.Any() == true)
                {
                    @foreach (var article in MentioningArticles)
                    {
                        <li><a href="@article.Url" target="_blank">@article.Title</a><span>@article.PublishedDate.ToString("MMM dd, yyyy")</span></li>
                    }
                }
                else
                {
                    <li>Loading articles...</li>
                }
            </ul>
        </div>
    </section>
</div>

@code {
    [Parameter] public string EntityId { get; set; } = string.Empty;

    private EntityDetailSummary? Detail;
    private IEnumerable<RelatedEntity>? RelatedEntities;
    private IEnumerable<ArticleSummary>? MentioningArticles;

    protected override async Task OnParametersSetAsync()
    {
        Detail = await Analytics.GetEntityDetailsAsync(EntityId);
        if (Detail is not null)
        {
            Detail.Trend = Detail.Trend
                .OrderBy(point => point.Date)
                .ToList();
        }
        RelatedEntities = await Analytics.GetRelatedEntitiesAsync(EntityId);
        MentioningArticles = await Analytics.GetMentioningArticlesAsync(EntityId);
    }
}
