@page "/network"
@using Agitprop.Web.Client.Components.Shared
@using Agitprop.Web.Client.Models
@inject Agitprop.Web.Client.Services.AnalyticsService Analytics
@inject NavigationManager Navigation

<PageTitle>Network Graph</PageTitle>

<div class="page-block">
    <div class="page-section-header">
        <div>
            <h2>Entity Network</h2>
            <p>Explore entity co-occurrence relationships with clickable nodes and weighted links.</p>
        </div>
    </div>

    <div class="panel-card network-graph-card">
        <div class="panel-header">
            <h3>Co-occurrence graph</h3>
        </div>
        <div class="chart-placeholder large">
            @if (NetworkPoints?.Any() == true)
            {
                <ApexChart TItem="NetworkScatterPoint"
                           OnDataPointSelection="OnNetworkPointSelected">
                    <ApexPointSeries TItem="NetworkScatterPoint"
                                     Items="NetworkPoints"
                                     Name="Entities"
                                     SeriesType="SeriesType.Scatter"
                                     XValue="point => point.WeightedDegree"
                                     YValue="point => point.Mentions" />
                </ApexChart>
            }
            else
            {
                <span>Loading network graph...</span>
            }
        </div>
    </div>
</div>

@code {
    private IEnumerable<NetworkNode>? NetworkNodes;
    private IEnumerable<NetworkEdge>? NetworkEdges;
    private List<NetworkScatterPoint>? NetworkPoints;

    protected override async Task OnInitializedAsync()
    {
        NetworkNodes = await Analytics.GetNetworkNodesAsync();
        NetworkEdges = await Analytics.GetNetworkEdgesAsync();

        BuildNetworkPoints();
    }

    private void NavigateToEntity(string entityId)
    {
        if (string.IsNullOrWhiteSpace(entityId))
        {
            return;
        }

        Navigation.NavigateTo($"/entity/{entityId}");
    }

    private void OnNetworkPointSelected(SelectedData<NetworkScatterPoint> selected)
    {
        var entityId = selected.DataPoint?.Items?.FirstOrDefault()?.EntityId;
        if (!string.IsNullOrWhiteSpace(entityId))
        {
            NavigateToEntity(entityId);
        }
    }

    private void BuildNetworkPoints()
    {
        var nodeList = NetworkNodes?.ToList() ?? new List<NetworkNode>();
        var edgeList = NetworkEdges?.ToList() ?? new List<NetworkEdge>();

        var weightedDegree = edgeList
            .SelectMany(edge => new[]
            {
                new { NodeId = edge.Source, edge.Weight },
                new { NodeId = edge.Target, edge.Weight }
            })
            .GroupBy(item => item.NodeId)
            .ToDictionary(group => group.Key, group => group.Sum(item => item.Weight));

        NetworkPoints = nodeList
            .Select(node => new NetworkScatterPoint
            {
                EntityId = node.Id,
                Label = node.Label,
                WeightedDegree = weightedDegree.TryGetValue(node.Id, out var degree) ? degree : 0,
                Mentions = node.Mentions
            })
            .ToList();
    }

    private sealed class NetworkScatterPoint
    {
        public string EntityId { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public decimal WeightedDegree { get; set; }
        public decimal Mentions { get; set; }
    }
}
