@page "/"
@page "/home"
@using Agitprop.Web.Client.Models
@using ApexCharts
@inject Agitprop.Web.Client.Services.AnalyticsService Analytics

<PageTitle>Landing</PageTitle>

<div class="page-block landing-page">
    <section class="landing-panel">

        <div class="timeframe-selector">
            @for (var i = 0; i < TimeframeOptions.Count; i++)
            {
                var option = TimeframeOptions[i];
                var optionIndex = i;

                <button class="timeframe-pill @(SelectedTimeframeIndex == optionIndex ? "active" : "")"
                        @onclick="() => ChangeTimeframe(optionIndex)">
                    @option.Label
                </button>
            }
        </div>

        <div>
            Showing results for <strong>@SelectedTimeframe.Label</strong>
        </div>

        <hr />

        <!-- DEBUG PANEL (remove later) -->
        <div style="font-size:12px; color:gray;">
            <div>TopEntities: @TopEntities.Count</div>
            <div>Timelines: @EntityTimelines.Count</div>
            <div>Range: @_debugFrom → @_debugTo</div>
        </div>

        <hr />

        <!-- CHART -->
        @if (IsLoading)
        {
            <div>Loading chart...</div>
        }
        else if (TopEntities.Any())
        {
            <ApexChart @ref="_chart"
                       @key="SelectedTimeframeIndex"
                       TItem="TimelinePoint"
                       XAxisType="XAxisType.Datetime"
                       Height="360">

                @foreach (var series in SelectedTrendSeries)
                {
                    <ApexPointSeries TItem="TimelinePoint"
                                     Items="series.Timeline"
                                     Name="@series.Name"
                                     SeriesType="SeriesType.Line"
                                     XValue="@(p => p.Date.ToDateTime(TimeOnly.MinValue))"
                                     YValue="@(p => (decimal?)p.Count)" />
                }

            </ApexChart>

            <!-- DEBUG: show actual data -->
            <div style="margin-top:10px; font-size:12px;">
                @foreach (var s in SelectedTrendSeries)
                {
                    <div><strong>@s.Name</strong>: @s.Timeline.Count points</div>
                }
            </div>
        }
        else
        {
            <div>No data available</div>
        }

    </section>
</div>

@code {
    private IReadOnlyList<EntitySummary> TopEntities { get; set; } = Array.Empty<EntitySummary>();

    private Dictionary<string, List<TimelinePoint>> EntityTimelines { get; set; }
        = new(StringComparer.OrdinalIgnoreCase);

    private ApexChart<TimelinePoint>? _chart;

    private int SelectedTimeframeIndex { get; set; }
    private bool IsLoading { get; set; }

    // DEBUG
    private DateOnly _debugFrom;
    private DateOnly _debugTo;

    private TimeframeOption SelectedTimeframe => TimeframeOptions[SelectedTimeframeIndex];

    private IEnumerable<EntityTrendSeries> SelectedTrendSeries =>
        TopEntities.Select((entity, index) =>
        {
            var key = entity.Id?.Trim() ?? "";

            EntityTimelines.TryGetValue(key, out var timeline);

            return new EntityTrendSeries
            {
                EntityId = entity.Id,
                Name = entity.Name,
                Color = TrendColor(index),
                Timeline = timeline ?? new List<TimelinePoint>()
            };
        });

    private static readonly List<TimeframeOption> TimeframeOptions = new()
    {
        new TimeframeOption("3 days", 3),
        new TimeframeOption("7 days", 7),
        new TimeframeOption("3 weeks", 21)
    };

    protected override async Task OnInitializedAsync()
    {
        SelectedTimeframeIndex = 0;
        await LoadHomepageDataAsync();
    }

    private async Task LoadHomepageDataAsync()
    {
        IsLoading = true;

        try
        {
            var range = GetSelectedRange();

            _debugFrom = range.From;
            _debugTo = range.To;

            var entities = await Analytics.GetTopMentionedEntitiesAsync(range.From, range.To);

            TopEntities = entities.Take(8).ToArray();

            if (TopEntities.Any())
            {
                var timelines = await Analytics.GetEntitiesTimelineAsync(
                    range.From,
                    range.To,
                    TopEntities.Select(e => e.Id));

                // ✅ normalize keys to prevent mismatch bugs
                EntityTimelines = timelines.ToDictionary(
                    kvp => kvp.Key.Trim(),
                    kvp => kvp.Value ?? new List<TimelinePoint>(),
                    StringComparer.OrdinalIgnoreCase);

                // DEBUG: log mismatches
                foreach (var e in TopEntities)
                {
                    if (!EntityTimelines.ContainsKey(e.Id.Trim()))
                    {
                        Console.WriteLine($"MISSING TIMELINE: {e.Id}");
                    }
                }
            }
            else
            {
                EntityTimelines = new(StringComparer.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
        finally
        {
            IsLoading = false;

            // ✅ force ApexCharts refresh
            if (_chart != null)
            {
                await _chart.UpdateSeriesAsync();
            }
        }
    }

    private async Task ChangeTimeframe(int optionIndex)
    {
        if (SelectedTimeframeIndex == optionIndex)
            return;

        SelectedTimeframeIndex = optionIndex;

        await LoadHomepageDataAsync();
    }

    private (DateOnly From, DateOnly To) GetSelectedRange()
    {
        var to = DateOnly.FromDateTime(DateTime.UtcNow);
        var from = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-SelectedTimeframe.Days));
        return (from, to);
    }

    private static string TrendColor(int index)
    {
        var palette = new[] { "#2563eb", "#16a34a", "#c2410c", "#7c3aed" };
        return palette[index % palette.Length];
    }

    private sealed record TimeframeOption(string Label, int Days);
}