@page "/"
@page "/home"
@rendermode InteractiveServer
@using Agitprop.Web.Client.Models
@inject Agitprop.Web.Client.Services.AnalyticsService Analytics

<PageTitle>Landing</PageTitle>

<div class="page-block landing-page">
    <section class="dashboard-intro">
        <div>
            <p class="page-kicker">Coverage monitor</p>
            <h1>What is drawing attention?</h1>
            <p>Track the people and organizations receiving the most coverage across monitored sources.</p>
        </div>
        <div class="timeframe-control">
            <span>Coverage window</span>
            <div class="timeframe-selector" role="group" aria-label="Coverage window">
                @for (var i = 0; i < TimeframeOptions.Count; i++)
                {
                    var option = TimeframeOptions[i];
                    var optionIndex = i;
                    <button type="button"
                            class="timeframe-pill @(SelectedTimeframeIndex == optionIndex ? "active" : string.Empty)"
                            disabled="@IsLoading" @onclick="() => ChangeTimeframe(optionIndex)">
                        @option.Label
                    </button>
            }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@ErrorMessage</div>
    }

    <div class="home-dashboard-grid">
        <section class="monitor-panel ranking-panel">
            <div class="panel-header">
                <div>
                    <h2>Most mentioned</h2>
                    <p>Ranked by coverage in the last @SelectedTimeframe.Label.</p>
                </div>
                <a class="text-link" href="/entities">View all entities</a>
            </div>

            @if (IsLoading)
            {
                <p class="data-state">Loading coverage…</p>
            }
            else if (TopEntities.Count == 0)
            {
                <p class="data-state">No entities were mentioned in this period.</p>
            }
            else
            {
                <ol class="entity-rank-list">
                    @foreach (var item in TopEntities.Select((entity, index) => (entity, index)))
                    {
                        <li>
                            <a href="/entity/@item.entity.Id" class="entity-rank-card">
                                <span class="entity-rank-place">@((item.index + 1).ToString("D2"))</span>
                                <span class="entity-rank-name">@item.entity.Name</span>
                                <span class="entity-rank-count">@item.entity.Mentions.ToString("N0") <span>mentions</span></span>
                            </a>
                        </li>
                    }
                </ol>
            }
        </section>

        <section class="monitor-panel chart-panel">
            <div class="panel-header">
                <div>
                    <h2>Trend line</h2>
                    <p>Daily mentions for the leading entities.</p>
                </div>
            </div>

            <div class="chart-content">
                @if (IsLoading)
                {
                    <p class="data-state">Loading trend line…</p>
                }
                else if (TopEntities.Count == 0)
                {
                    <p class="data-state">No trend data is available for this period.</p>
                }
                else if (!VisibleTrendSeries.Any())
                {
                    <p class="data-state">Select at least one entity to see its trend.</p>
                }
                else
                {
                    <ApexChart @key="ChartKey" TItem="TimelinePoint" XAxisType="XAxisType.Datetime"
                               Height="360"
                               Options="ReadOnlyChartOptions">
                        @foreach (var series in VisibleTrendSeries)
                        {
                            <ApexPointSeries TItem="TimelinePoint" Items="series.Timeline" Name="@series.Name"
                                             SeriesType="SeriesType.Line"
                                             Stroke="@(new SeriesStroke { Color = series.Color, Width = 2 })"
                                             XValue="@(point => DateTime.SpecifyKind(point.Date.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc))"
                                             YValue="@(point => (decimal?)point.Count)" />
                        }
                    </ApexChart>
                }
            </div>

            @if (!IsLoading && TopEntities.Count > 0)
            {
                <div class="trend-legend" role="group" aria-label="Chart entities">
                    <div class="trend-legend-actions">
                        <button type="button" class="legend-action-button"
                                disabled="@AllSelected" @onclick="SelectAll">
                            Select all
                        </button>
                        <button type="button" class="legend-action-button"
                                disabled="@(SelectedEntityIds.Count == 0)" @onclick="DeselectAll">
                            Deselect all
                        </button>
                    </div>
                    <div class="trend-legend-items">
                        @foreach (var item in TopEntities.Select((entity, index) => (entity, index)))
                        {
                            var entityId = item.entity.Id;
                            var isSelected = SelectedEntityIds.Contains(entityId);
                            <button type="button"
                                    class="trend-legend-item @(isSelected ? "selected" : string.Empty)"
                                    style="--entity-color: @TrendColor(item.index)"
                                    aria-pressed="@isSelected"
                                    @onclick="() => ToggleEntity(entityId)">
                                <span class="trend-legend-marker" aria-hidden="true"></span>
                                <span class="trend-legend-name">@item.entity.Name</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private readonly ApexChartOptions<TimelinePoint> ReadOnlyChartOptions = new()
    {
        Chart = new Chart
        {
            Zoom = new Zoom { Enabled = false },
            Selection = new Selection { Enabled = false },
            Toolbar = new Toolbar { Show = false }
        },
        Legend = new Legend { Show = false },
        Yaxis =
        [
            new YAxis
            {
                Labels = new YAxisLabels { Formatter = "function(val) { return Math.round(val); }" },
                ForceNiceScale = true
            }
        ],
        Tooltip = new Tooltip
        {
            Y = new TooltipY { Formatter = "function(val) { return Math.round(val); }" }
        }
    };

    private IReadOnlyList<EntitySummary> TopEntities { get; set; } = Array.Empty<EntitySummary>();

    private Dictionary<string, List<TimelinePoint>> EntityTimelines { get; set; }
        = new(StringComparer.OrdinalIgnoreCase);

    private int _loadVersion;

    private int SelectedTimeframeIndex { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private TimeframeOption SelectedTimeframe => TimeframeOptions[SelectedTimeframeIndex];

    private HashSet<string> SelectedEntityIds { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private bool AllSelected => TopEntities.Count > 0 && SelectedEntityIds.Count == TopEntities.Count;

    private string ChartKey =>
        $"{SelectedTimeframeIndex}-{string.Join(',', TopEntities.Where(e => SelectedEntityIds.Contains(e.Id)).Select(e => e.Id))}";

    private IEnumerable<EntityTrendSeries> VisibleTrendSeries =>
        SelectedTrendSeries.Where(series => SelectedEntityIds.Contains(series.EntityId));

    private void ToggleEntity(string entityId)
    {
        if (!SelectedEntityIds.Remove(entityId))
        {
            SelectedEntityIds.Add(entityId);
        }
    }

    private void SelectAll()
    {
        SelectedEntityIds = new HashSet<string>(TopEntities.Select(e => e.Id), StringComparer.OrdinalIgnoreCase);
    }

    private void DeselectAll()
    {
        SelectedEntityIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private IEnumerable<EntityTrendSeries> SelectedTrendSeries =>
        TopEntities.Select((entity, index) => new EntityTrendSeries
        {
            EntityId = entity.Id,
            Name = entity.Name,
            Color = TrendColor(index),
            Timeline = EntityTimelines.TryGetValue(entity.Id, out var timeline)
                ? timeline
                : new List<TimelinePoint>()
        });

    private static readonly List<TimeframeOption> TimeframeOptions = new()
    {
        new TimeframeOption("3 days", 3),
        new TimeframeOption("7 days", 7),
        new TimeframeOption("3 weeks", 21)
    };

    protected override async Task OnInitializedAsync()
    {
        SelectedTimeframeIndex = 0;
        await LoadHomepageDataAsync();
    }

    private async Task LoadHomepageDataAsync()
    {
        var loadVersion = Interlocked.Increment(ref _loadVersion);

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var range = GetSelectedRange();

            var topEntities = (await Analytics.GetTopMentionedEntitiesAsync(range.From, range.To))
                .Take(8)
                .ToArray();

            var timelines = new Dictionary<string, List<TimelinePoint>>(StringComparer.OrdinalIgnoreCase);

            if (topEntities.Any())
            {
                var rawTimeline = await Analytics.GetEntitiesTimelineAsync(
                    range.From,
                    range.To,
                    topEntities.Select(entity => entity.Id));

                timelines = rawTimeline.ToDictionary(
                    entry => entry.Key.Trim(),
                    entry => entry.Value ?? new List<TimelinePoint>(),
                    StringComparer.OrdinalIgnoreCase);
            }

            if (loadVersion != _loadVersion)
            {
                return;
            }

            ReadOnlyChartOptions.Xaxis = DailyAxis(SelectedTimeframe.Days + 1);
            TopEntities = topEntities;
            SelectedEntityIds = new HashSet<string>(topEntities.Select(e => e.Id), StringComparer.OrdinalIgnoreCase);
            EntityTimelines = timelines;
        }
        catch
        {
            if (loadVersion != _loadVersion)
            {
                return;
            }

            ErrorMessage = "Unable to load homepage data.";
            TopEntities = Array.Empty<EntitySummary>();
            EntityTimelines = new Dictionary<string, List<TimelinePoint>>(StringComparer.OrdinalIgnoreCase);
        }
        finally
        {
            if (loadVersion == _loadVersion)
            {
                IsLoading = false;
            }
        }
    }

    private async Task ChangeTimeframe(int optionIndex)
    {
        if (SelectedTimeframeIndex == optionIndex)
            return;

        SelectedTimeframeIndex = optionIndex;

        await LoadHomepageDataAsync();
    }

    private (DateOnly From, DateOnly To) GetSelectedRange()
    {
        var to = DateOnly.FromDateTime(DateTime.UtcNow);
        var from = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-SelectedTimeframe.Days));
        return (from, to);
    }

    private static XAxis DailyAxis(int days) => new()
    {
        TickAmount = Math.Max(days - 1, 1),
        Labels = new XAxisLabels { DatetimeUTC = true, Format = "dd MMM", HideOverlappingLabels = false }
    };

    private static string TrendColor(int index)
    {
        var palette = new[] { "#135D91", "#407A5A", "#D99024", "#7053A6", "#257C82", "#A64D4D", "#6B7A8F", "#B5651D" };
        return palette[index % palette.Length];
    }

    private sealed record TimeframeOption(string Label, int Days);
}