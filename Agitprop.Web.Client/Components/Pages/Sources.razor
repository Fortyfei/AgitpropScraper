@page "/sources"
@rendermode InteractiveServer
@using Agitprop.Web.Client.Models
@using ApexCharts
@inject Agitprop.Web.Client.Services.AnalyticsService Analytics

<PageTitle>Sources</PageTitle>

<div class="page-block sources-page">
    <section class="sources-intro">
        <div>
            <p class="page-kicker">Directory</p>
            <h1>Sources</h1>
            <p>See which publishers are shaping the monitored conversation.</p>
        </div>

        <div class="timeframe-control">
            <span>Coverage window</span>
            <div class="timeframe-selector" role="group" aria-label="Coverage window">
                @for (var i = 0; i < TimeframeOptions.Count; i++)
                {
                    var option = TimeframeOptions[i];
                    var optionIndex = i;
                    <button type="button"
                            class="timeframe-pill @(SelectedTimeframeIndex == optionIndex ? "active" : string.Empty)"
                            disabled="@IsLoading"
                            @onclick="() => ChangeTimeframe(optionIndex)">
                        @option.Label
                    </button>
                }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@ErrorMessage</div>
    }

    @if (!IsLoading && SourceItems.Count > 0)
    {
        <section class="sources-panel">
            <div class="panel-header">
                <div>
                    <h2>Share of coverage</h2>
                    <p>Top publishers; the rest are grouped as Other.</p>
                </div>
            </div>
            <ApexChart @key="SelectedTimeframeIndex" TItem="PieSlice" Height="340" Options="PieOptions">
                <ApexPointSeries TItem="PieSlice" Items="PieSlices" Name="Articles"
                                 SeriesType="SeriesType.Donut"
                                 XValue="@(slice => slice.Label)"
                                 YValue="@(slice => (decimal?)slice.Count)" />
            </ApexChart>
        </section>
    }

    <section class="sources-panel source-entity-panel">
        <div class="panel-header">
            <div>
                <h2>Publisher coverage by entity</h2>
                <p>Share of each publisher’s articles that mention a leading entity.</p>
            </div>
        </div>

        @if (IsLoading)
        {
            <p class="data-state">Loading entity coverage…</p>
        }
        else if (!string.IsNullOrWhiteSpace(CoverageError))
        {
            <p class="data-state coverage-error" role="alert">@CoverageError</p>
        }
        else if (SourceEntityCoverage.Count == 0 || CoverageEntities.Count == 0)
        {
            <p class="data-state">No publisher/entity coverage is available for this period.</p>
        }
        else
        {
            <div class="coverage-table-scroll" tabindex="0" aria-label="Publisher coverage table; scroll horizontally to see all entities">
                <table class="coverage-table">
                    <thead>
                        <tr>
                            <th scope="col">Publisher</th>
                            <th scope="col">Articles</th>
                            @foreach (var entity in CoverageEntities)
                            {
                                <th scope="col">
                                    <a href="@($"/entity/{entity.EntityId}")" title="@($"{entity.EntityName} ({entity.EntityType})")">
                                        @entity.EntityName
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var source in SourceEntityCoverage)
                        {
                            <tr>
                                <th scope="row">@source.Domain</th>
                                <td>@source.ArticleCount.ToString("N0")</td>
                                @foreach (var entity in source.Entities)
                                {
                                    <td>
                                        <div class="coverage-cell"
                                             aria-label="@($"{entity.ArticleCount} of {source.ArticleCount} articles, {FormatPercent(entity.PercentOfSourceArticles)} percent")">
                                            <strong>@FormatPercent(entity.PercentOfSourceArticles)%</strong>
                                            <span class="coverage-cell-track" aria-hidden="true">
                                                <span style="width: @FormatPercent(entity.PercentOfSourceArticles)%"></span>
                                            </span>
                                            <small>@entity.ArticleCount.ToString("N0") articles</small>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="coverage-note">Percentages use all articles from that publisher in the selected period. Entity columns show the most-mentioned entities overall.</p>
        }
    </section>

    <section class="sources-panel">
        <div class="panel-header">
            <div>
                <h2>Publisher coverage</h2>
                <p>Articles grouped by normalized publisher domain.</p>
            </div>
            @if (!IsLoading && SourceItems.Count > 0)
            {
                <span>@TotalMentions.ToString("N0") articles</span>
            }
        </div>

        @if (IsLoading)
        {
            <p class="data-state">Loading sources…</p>
        }
        else if (SourceItems.Count == 0)
        {
            <p class="data-state">No source coverage is available for this period.</p>
        }
        else
        {
            <ol class="source-list">
                @foreach (var source in SourceItems)
                {
                    <li class="source-row">
                        <span class="source-rank">@((SourceItems.IndexOf(source) + 1).ToString("D2"))</span>
                        <div class="source-main">
                            <div class="source-name-row">
                                <span class="source-name">@source.Domain</span>
                                <span class="source-count">@source.Count.ToString("N0")</span>
                            </div>
                            <div class="source-bar-track" aria-hidden="true">
                                <div class="source-bar-fill" style="width: @(source.Percent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                        <span class="source-percent">@source.Percent.ToString("F1")%</span>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@code {
    private static readonly List<TimeframeOption> TimeframeOptions =
    [
        new("3 days", 3),
        new("7 days", 7),
        new("3 weeks", 21)
    ];

    private List<SourceStat> SourceItems { get; set; } = [];
    private List<SourceEntityCoverage> SourceEntityCoverage { get; set; } = [];
    private int SelectedTimeframeIndex { get; set; } = 1;
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string? CoverageError { get; set; }
    private TimeframeOption SelectedTimeframe => TimeframeOptions[SelectedTimeframeIndex];
    private int TotalMentions => SourceItems.Sum(source => source.Count);
    private List<EntityCoverageStat> CoverageEntities =>
        SourceEntityCoverage.FirstOrDefault()?.Entities ?? [];

    private sealed record PieSlice(string Label, int Count);

    private List<PieSlice> PieSlices
    {
        get
        {
            var slices = SourceItems.Take(6).Select(source => new PieSlice(source.Domain, source.Count)).ToList();
            var other = SourceItems.Skip(6).Sum(source => source.Count);
            if (other > 0)
                slices.Add(new PieSlice("Other", other));
            return slices;
        }
    }

    private static readonly ApexChartOptions<PieSlice> PieOptions = new()
    {
        Colors = ["#135D91", "#D99024", "#407A5A", "#7053A6", "#257C82", "#A64D4D", "#9AA7B4"],
        Legend = new Legend { Position = LegendPosition.Bottom }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        CoverageError = null;

        try
        {
            var range = GetSelectedRange();
            var sourcesTask = Analytics.GetSourcesAsync(range.From, range.To);
            var entityCoverageTask = Analytics.GetSourceEntityCoverageAsync(range.From, range.To);
            await Task.WhenAll(sourcesTask, entityCoverageTask);

            var result = await sourcesTask;
            if (result is null)
            {
                SourceItems = [];
                ErrorMessage = "Unable to load source statistics.";
            }
            else
            {
                SourceItems = result;
            }

            var entityCoverage = await entityCoverageTask;
            SourceEntityCoverage = entityCoverage ?? [];
            CoverageError = entityCoverage is null ? "Unable to load publisher/entity coverage." : null;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ChangeTimeframe(int index)
    {
        if (SelectedTimeframeIndex == index)
            return;

        SelectedTimeframeIndex = index;
        await LoadAsync();
    }

    private (DateOnly From, DateOnly To) GetSelectedRange()
    {
        var to = DateOnly.FromDateTime(DateTime.UtcNow);
        var from = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-SelectedTimeframe.Days));
        return (from, to);
    }

    private static string FormatPercent(double value) =>
        value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private sealed record TimeframeOption(string Label, int Days);
}
