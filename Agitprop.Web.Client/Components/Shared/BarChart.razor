@using Agitprop.Web.Client.Models

@if (Items.Any())
{
    <svg class="analytics-chart" viewBox="0 0 @ViewWidth @ViewHeight" role="img" aria-label="Top entities bar chart">
        <line x1="50" y1="20" x2="50" y2="@PlotBottom" class="chart-axis" />
        <line x1="50" y1="@PlotBottom" x2="@PlotRight" y2="@PlotBottom" class="chart-axis" />

        @foreach (var bar in Bars)
        {
            <g class="chart-bar-group" @onclick="() => OnEntityClick.InvokeAsync(bar.Entity.Id)">
                <rect x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" class="chart-bar" rx="5" />
                <title>@bar.Entity.Name: @bar.Entity.Mentions mentions</title>
            </g>
        }
    </svg>
}
else
{
    <div class="chart-empty">No bar chart data available.</div>
}

@code {
    [Parameter] public IEnumerable<EntitySummary> Items { get; set; } = Enumerable.Empty<EntitySummary>();
    [Parameter] public EventCallback<string> OnEntityClick { get; set; }

    private const double ViewWidth = 860;
    private const double ViewHeight = 300;
    private const double PlotBottom = 250;
    private const double PlotRight = 820;

    private IReadOnlyList<BarPoint> Bars
    {
        get
        {
            var entities = Items.Take(10).ToList();
            if (entities.Count == 0)
            {
                return [];
            }

            var max = Math.Max(entities.Max(item => item.Mentions), 1);
            var totalWidth = PlotRight - 60;
            var slotWidth = totalWidth / entities.Count;
            var barWidth = slotWidth * 0.68;

            var points = new List<BarPoint>(entities.Count);
            for (var i = 0; i < entities.Count; i++)
            {
                var entity = entities[i];
                var height = (entity.Mentions / (double)max) * 200;
                var x = 60 + (i * slotWidth) + ((slotWidth - barWidth) / 2);
                points.Add(new BarPoint
                {
                    Entity = entity,
                    X = x,
                    Y = PlotBottom - height,
                    Width = barWidth,
                    Height = height
                });
            }

            return points;
        }
    }

    private sealed class BarPoint
    {
        public required EntitySummary Entity { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
