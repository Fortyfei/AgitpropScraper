@using Agitprop.Web.Client.Models

@if (NormalizedSeries.Any(series => series.Points.Count > 1))
{
    <svg class="analytics-chart" viewBox="0 0 860 320" role="img" aria-label="Entity trends comparison chart">
        <line x1="50" y1="20" x2="50" y2="250" class="chart-axis" />
        <line x1="50" y1="250" x2="820" y2="250" class="chart-axis" />

        @foreach (var series in NormalizedSeries)
        {
            <polyline points="@series.Polyline" fill="none" stroke="@series.Color" stroke-width="3" class="chart-line">
                <title>@series.Name</title>
            </polyline>

            @foreach (var point in series.Points)
            {
                <circle cx="@point.X" cy="@point.Y" r="3.5" fill="@series.Color" class="chart-point">
                    <title>@series.Name · @point.Date.ToString("MMM dd"): @point.Count</title>
                </circle>
            }
        }

    </svg>

    <div class="multi-line-legend">
        @foreach (var series in NormalizedSeries)
        {
            <div class="legend-item">
                <span class="legend-color" style="background:@series.Color"></span>
                <span>@series.Name</span>
            </div>
        }
    </div>
}
else
{
    <div class="chart-empty">No trend comparison data available.</div>
}

@code {
    [Parameter] public IEnumerable<EntityTrendSeries> Series { get; set; } = Enumerable.Empty<EntityTrendSeries>();

    private IReadOnlyList<NormalizedTrendSeries> NormalizedSeries
    {
        get
        {
            var input = Series.ToList();
            if (input.Count == 0)
            {
                return [];
            }

            var allValues = input.SelectMany(item => item.Timeline).ToList();
            if (allValues.Count == 0)
            {
                return [];
            }

            var max = Math.Max(allValues.Max(point => point.Count), 1);
            var maxPoints = input.Max(series => series.Timeline.Count);
            var step = maxPoints > 1 ? 760d / (maxPoints - 1) : 760d;

            return input.Select(series =>
            {
                var points = series.Timeline
                    .OrderBy(point => point.Date)
                    .Select((point, index) => new TrendPoint
                    {
                        Date = point.Date,
                        Count = point.Count,
                        X = 50 + (index * step),
                        Y = 250 - ((point.Count / (double)max) * 210)
                    })
                    .ToList();

                return new NormalizedTrendSeries
                {
                    Name = series.Name,
                    Color = string.IsNullOrWhiteSpace(series.Color) ? "#2563eb" : series.Color,
                    Points = points,
                    Polyline = string.Join(" ", points.Select(point => $"{point.X},{point.Y}"))
                };
            }).ToList();
        }
    }

    private sealed class NormalizedTrendSeries
    {
        public required string Name { get; set; }
        public required string Color { get; set; }
        public required List<TrendPoint> Points { get; set; }
        public required string Polyline { get; set; }
    }

    private sealed class TrendPoint
    {
        public DateOnly Date { get; set; }
        public int Count { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
    }
}
