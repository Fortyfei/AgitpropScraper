{
  "configurations": [
    {
      "name": "C#: Agitprop.CLI Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Agitprop.CLI/bin/Debug/net10.0/Agitprop.CLI.exe",
      "args": [
        "scrape-archive",
        "-d",
        "2025-11-22",
        "-s",
        "ripost",
        "-c",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "type": "aspire",
      "request": "launch",
      "name": "Aspire: Launch default AppHost",
      "program": "${workspaceFolder}"
    }
  ]
}